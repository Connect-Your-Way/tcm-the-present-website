# ─── tcm-the-present env-var schema ───────────────────────────────────────
# This file is committed; .env.local is git-ignored. No real secrets here.
# Conformance: shared/platform/STACK.md (no PUBLIC_* — server-only or
# server-rendered content; runtime secrets in Fly.io secrets at production).

# ── Server-only secrets ──
# Resend API key — sign up at https://resend.com (free tier 3,000 emails/mo)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The practitioner's inbox — never rendered to HTML or any API response.
# Replace with Zacc Kim's real email before production.
CONTACT_EMAIL=placeholder@example.com

# Resend "from" address. Default is Resend's sandbox sender; works at demo.
# Post-domain-verification (production phase), replace with no_reply@<verified-domain>.
RESEND_FROM_ADDRESS=onboarding@resend.dev

# ── Server-rendered content (treated as env to allow swap without code change) ──
# Practitioner's mobile number — rendered on Contact page + header pill.
# Placeholder triggers the F-09 "(to be confirmed)" UX.
PHONE_NUMBER="+61 4XX XXX XXX"

# KakaoTalk profile deeplink — rendered as a button on Contact + footer.
# Set to "#" to render the placeholder/disabled state (F-09); replace with
# the real URL when client provides it.
KAKAOTALK_URL=#

# ── SEO / canonical URL ──
# Production canonical base URL — used in <link rel="canonical"> and hreflang tags.
# Set to your production https://… URL before deploy (e.g. https://tcmthepresent.com.au).
# Demo / local-dev default is http://localhost:3001 (no trailing slash needed).
SITE_URL=http://localhost:3001
