---
/**
 * /ko/contact — Contact page (Korean locale) — M05 full implementation
 * Static page (prerender=true) with ContactForm island.
 * Per §06 04-contact.md: two-column layout on desktop, single column on mobile.
 * ADR-001: prerender=true + client-side island via <script> in ContactForm.
 */
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import ContactForm from "../../components/ContactForm.astro";
import { loadLocaleBundle, getString } from "../../lib/i18n.ts";

const locale = "ko" as const;
const bundle = loadLocaleBundle(locale);

const title = getString(bundle, "contact.page.title");
const description = getString(bundle, "contact.page.description");

const phoneNumber: string =
  (import.meta.env.PHONE_NUMBER as string | undefined) ?? "+61 4XX XXX XXX";
const kakaotalkUrl: string =
  (import.meta.env.KAKAOTALK_URL as string | undefined) ?? "#";
const isPhonePlaceholder = !phoneNumber || phoneNumber.includes("4XX");
const isKakaotalkPlaceholder = !kakaotalkUrl || kakaotalkUrl === "#";

const formStrings = {
  labelName: getString(bundle, "contact.form.labelName"),
  labelEmail: getString(bundle, "contact.form.labelEmail"),
  labelMessage: getString(bundle, "contact.form.labelMessage"),
  placeholderName: getString(bundle, "contact.form.placeholderName"),
  placeholderEmail: getString(bundle, "contact.form.placeholderEmail"),
  placeholderMessage: getString(bundle, "contact.form.placeholderMessage"),
  submit: getString(bundle, "contact.form.submit"),
  submitting: getString(bundle, "contact.form.submitting"),
  successMessage: getString(bundle, "contact.form.successMessage"),
  errorMessage: getString(bundle, "contact.form.errorMessage"),
  errorRequired: getString(bundle, "contact.form.errorRequired"),
  errorTooLong: getString(bundle, "contact.form.errorTooLong"),
  errorEmail: getString(bundle, "contact.form.errorEmail"),
  sendAnother: getString(bundle, "contact.form.sendAnother"),
};
---

<Layout title={title} description={description} locale={locale} currentPath="/contact">
  <!-- Page hero (§06 04-contact.md §3) -->
  <section class="contact-hero">
    <div class="container">
      <h1 class="contact-h1">{getString(bundle, "contact.hero.headline")}</h1>
      <p class="contact-intro">{getString(bundle, "contact.hero.intro")}</p>
    </div>
  </section>

  <!-- Two-column contact body (§06 04-contact.md §2) -->
  <section class="contact-body">
    <div class="container">
      <div class="contact-grid">
        <!-- Left column: contact form -->
        <div class="contact-form-col">
          <ContactForm locale={locale} strings={formStrings} />
        </div>

        <!-- Right column: phone, KakaoTalk, service area note -->
        <aside class="contact-sidebar">
          <!-- Phone number (§06 04-contact.md §5) -->
          <div class="sidebar-section">
            <h2 class="sidebar-heading">{getString(bundle, "contact.phone.label")}</h2>
            {isPhonePlaceholder ? (
              <p
                class="sidebar-phone-placeholder"
                data-placeholder="phone-number"
              >
                <span class="phone-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
                  </svg>
                </span>
                {getString(bundle, "contact.phone.placeholder")}
              </p>
            ) : (
              <a
                class="sidebar-phone-link"
                href={`tel:${phoneNumber.replace(/\s/g, "")}`}
                aria-label={`전화 ${phoneNumber}`}
              >
                <span class="phone-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
                  </svg>
                </span>
                {phoneNumber}
              </a>
            )}
          </div>

          <!-- KakaoTalk button (§06 04-contact.md §6, §07 Flow 5) -->
          <div class="sidebar-section">
            <h2 class="sidebar-heading">카카오톡</h2>
            {isKakaotalkPlaceholder ? (
              <button
                class="btn-kakao btn-kakao--disabled"
                type="button"
                aria-disabled="true"
                title={getString(bundle, "contact.kakao.tooltip")}
                data-placeholder="kakaotalk-url"
              >
                <svg class="kakao-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20">
                  <path d="M12 3C6.477 3 2 6.477 2 10.8c0 2.79 1.618 5.24 4.073 6.767L5.1 21l4.426-2.34C10.01 18.87 10.997 19 12 19c5.523 0 10-3.477 10-7.8S17.523 3 12 3z"/>
                </svg>
                {getString(bundle, "contact.kakao.label")}
                <span class="kakao-coming-soon">({getString(bundle, "contact.kakao.tooltip")})</span>
              </button>
            ) : (
              <a
                class="btn-kakao"
                href={kakaotalkUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="카카오톡 열기"
              >
                <svg class="kakao-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20">
                  <path d="M12 3C6.477 3 2 6.477 2 10.8c0 2.79 1.618 5.24 4.073 6.767L5.1 21l4.426-2.34C10.01 18.87 10.997 19 12 19c5.523 0 10-3.477 10-7.8S17.523 3 12 3z"/>
                </svg>
                {getString(bundle, "contact.kakao.label")}
              </a>
            )}
          </div>

          <!-- Service area note (§06 04-contact.md §7) -->
          <p class="sidebar-service-area">
            {getString(bundle, "contact.serviceArea.note")}
          </p>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-hero {
    background: var(--color-accent-subtle);
    padding: var(--space-3xl) 0 var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .contact-h1 {
    font-family: var(--font-ko);
    font-size: var(--text-h1);
    color: var(--color-text-heading);
    font-weight: 700;
    margin-bottom: var(--space-lg);
  }

  .contact-intro {
    font-family: var(--font-ko);
    font-size: var(--text-body-lg);
    color: var(--color-text-body);
    max-width: 600px;
    line-height: 1.7;
  }

  .contact-body {
    padding: var(--space-3xl) 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 55% 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
  }

  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .sidebar-heading {
    font-family: var(--font-ko);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    color: var(--color-text-heading);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .sidebar-phone-placeholder,
  .sidebar-phone-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-ko);
    font-size: var(--text-body-lg);
    font-weight: 600;
    color: var(--color-text-body);
    text-decoration: none;
  }

  .sidebar-phone-link {
    color: var(--color-primary);
  }

  .sidebar-phone-link:hover,
  .sidebar-phone-link:focus-visible {
    color: var(--color-primary-mid);
    text-decoration: underline;
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .phone-icon {
    display: flex;
    align-items: center;
    color: inherit;
  }

  .btn-kakao {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.75rem 1.25rem;
    background: #fee500;
    color: #391b1b;
    font-family: var(--font-ko);
    font-size: var(--text-ui);
    font-weight: 600;
    border-radius: 10px;
    border: none;
    text-decoration: none;
    min-height: 44px;
    cursor: pointer;
    transition: background 0.15s ease, opacity 0.15s ease;
    width: fit-content;
  }

  .btn-kakao:hover:not(.btn-kakao--disabled),
  .btn-kakao:focus-visible {
    background: #ffd700;
    outline: 2px solid #391b1b;
    outline-offset: 2px;
  }

  .btn-kakao--disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .kakao-icon {
    flex-shrink: 0;
  }

  .kakao-coming-soon {
    font-size: var(--text-body-sm);
    font-weight: 400;
    opacity: 0.8;
    margin-left: var(--space-xs);
  }

  .sidebar-service-area {
    font-family: var(--font-ko);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
    border-left: 3px solid var(--color-border);
    padding-left: var(--space-md);
  }

  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }
</style>
