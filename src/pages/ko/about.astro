---
/**
 * /ko/about — About the Practitioner page (Korean)
 * M04: Full implementation — Intro, Portrait + Bio/Qualifications, Clinical Philosophy,
 *      Contact CTA strip. Philosophy text from 진료 철학_260626_174559.docx (Korean).
 * Layout per §06 03-about.md §2. Korean locale: placeholder strings from ko.json
 *      (not English fallback) per F-09 AC.
 * ADR-001: prerender = true (static page)
 */
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import SectionBand from "../../components/SectionBand.astro";
import PlaceholderBlock from "../../components/PlaceholderBlock.astro";
import PlaceholderImage from "../../components/PlaceholderImage.astro";
import CtaStrip from "../../components/CtaStrip.astro";
import { loadLocaleBundle, getString } from "../../lib/i18n.ts";

const locale = "ko" as const;
const bundle = loadLocaleBundle(locale);
const title = getString(bundle, "about.page.title");
const description = getString(bundle, "about.page.description");

// Philosophy body paragraph keys — 7 paragraphs (same key set as EN for parity)
const philosophyParagraphKeys = [
  "about.philosophy.body_1",
  "about.philosophy.body_2",
  "about.philosophy.body_3",
  "about.philosophy.body_4",
  "about.philosophy.body_5",
  "about.philosophy.body_6",
  "about.philosophy.body_7",
] as const;
---

<Layout title={title} description={description} locale={locale} currentPath="/about">

  <!-- ── PAGE INTRO / HERO SECTION ──────────────────────────────────────── -->
  <!-- Per §06 03-about.md §3: eyebrow + <h1> + intro sentence (Korean).
       Korean locale: all text from ko.json bundles. font-ko applied for headings
       with Korean characters. -->
  <section class="about-intro">
    <div class="container about-intro-inner">
      <p class="intro-eyebrow font-ko">{getString(bundle, "about.hero.eyebrow")}</p>
      <h1 class="intro-headline font-ko">{getString(bundle, "about.hero.headline")}</h1>
      <p class="intro-body font-ko">{getString(bundle, "about.hero.intro")}</p>
    </div>
  </section>

  <!-- ── PORTRAIT + BIO SECTION ────────────────────────────────────────── -->
  <!-- §06 §4: two-column on desktop, single column on mobile.
       Profile photo: PlaceholderImage with data-placeholder="profile-photo" (M04 AC-1).
       Alt text from ko.json about.profilePhoto.altPlaceholder (Korean string, §06 §10).
       Placeholder blocks pull from ko.json (not EN fallback) per F-09 AC (M04 AC-2). -->
  <section class="portrait-section">
    <div class="container portrait-inner">

      <!-- Portrait column -->
      <div class="portrait-col">
        <PlaceholderImage
          placeholderId="profile-photo"
          altKey="about.profilePhoto.altPlaceholder"
          blobVariant={2}
          bundle={bundle}
        />
      </div>

      <!-- Bio + qualifications column -->
      <div class="bio-col">

        <!-- Bio placeholder — Korean string from ko/placeholder.json (M04 AC-2) -->
        <div class="bio-block">
          <h2 class="bio-heading font-ko">{getString(bundle, "about.bio.heading")}</h2>
          <PlaceholderBlock
            placeholderId="practitioner-bio"
            i18nKey="placeholder.practitioner_bio"
            bundle={bundle}
            locale={locale}
          />
        </div>

        <!-- Qualifications placeholder — Korean string from ko/placeholder.json -->
        <div class="qualifications-block">
          <h3 class="qualifications-heading font-ko">{getString(bundle, "about.qualifications.heading")}</h3>
          <PlaceholderBlock
            placeholderId="practitioner-qualifications"
            i18nKey="placeholder.practitioner_qualifications"
            bundle={bundle}
            locale={locale}
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ── CLINICAL PHILOSOPHY SECTION ───────────────────────────────────── -->
  <!-- §06 §5: full Korean philosophy text from 진료 철학_260626_174559.docx.
       Soft-green background band. 7 Korean paragraphs (body_1..body_7).
       font-ko applied for Korean readability (Noto Sans KR). -->
  <SectionBand background="soft">
    <div class="philosophy-inner">
      <h2 class="philosophy-heading font-ko">{getString(bundle, "about.philosophy.heading")}</h2>
      <div class="philosophy-body">
        {philosophyParagraphKeys.map((key) => (
          <p class="philosophy-para font-ko">{getString(bundle, key)}</p>
        ))}
      </div>
    </div>
  </SectionBand>

  <!-- ── CONTACT CTA STRIP ─────────────────────────────────────────────── -->
  <!-- §06 §6: bottom-of-page conversion. Korean CTA text + link to /ko/contact/. -->
  <CtaStrip
    sentence={getString(bundle, "about.cta.sentence")}
    buttonLabel={getString(bundle, "about.cta.buttonLabel")}
    buttonHref="/ko/contact/"
  />

</Layout>

<style>
  /* ── Page intro / hero section ─────────────────────────────────────── */
  .about-intro {
    padding: var(--space-3xl) 0 var(--space-2xl);
    background: var(--color-bg);
  }

  .about-intro-inner {
    max-width: 52rem;
  }

  .intro-eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .intro-eyebrow.font-ko {
    font-family: var(--font-ko);
    letter-spacing: 0.04em;
  }

  .intro-headline {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 700;
    color: var(--color-text-heading);
    line-height: 1.2;
    margin-bottom: var(--space-lg);
  }

  .intro-headline.font-ko {
    font-family: var(--font-ko);
    font-weight: 700;
  }

  .intro-body {
    font-family: var(--font-sans);
    font-size: var(--text-body-xl);
    color: var(--color-text-body);
    line-height: 1.75;
    max-width: 44rem;
  }

  .intro-body.font-ko {
    font-family: var(--font-ko);
    line-height: 1.85;
  }

  /* ── Portrait + bio section ───────────────────────────────────────── */
  .portrait-section {
    padding: var(--space-3xl) 0;
    background: var(--color-bg-alt);
  }

  /* Two-column layout: portrait left (~40%), bio right (~60%) */
  .portrait-inner {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .portrait-col {
    display: flex;
    justify-content: center;
  }

  .bio-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .bio-heading {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 700;
    color: var(--color-text-heading);
    margin-bottom: var(--space-lg);
    line-height: 1.25;
  }

  .bio-heading.font-ko {
    font-family: var(--font-ko);
  }

  .qualifications-heading {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-text-heading);
    margin-bottom: var(--space-lg);
    line-height: 1.3;
  }

  .qualifications-heading.font-ko {
    font-family: var(--font-ko);
  }

  /* ── Clinical philosophy section ──────────────────────────────────── */
  .philosophy-inner {
    padding: var(--space-2xl) 0;
    max-width: 48rem;
    margin: 0 auto;
  }

  .philosophy-heading {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 700;
    color: var(--color-text-heading);
    margin-bottom: var(--space-2xl);
    line-height: 1.25;
    text-align: center;
  }

  .philosophy-heading.font-ko {
    font-family: var(--font-ko);
  }

  .philosophy-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* Line-height ≥ 1.6 for the 60+ demographic (§06 §9) */
  .philosophy-para {
    font-family: var(--font-sans);
    font-size: var(--text-body-lg);
    color: var(--color-text-body);
    line-height: 1.75;
    text-align: left;
  }

  .philosophy-para.font-ko {
    font-family: var(--font-ko);
    line-height: 1.9;
  }

  /* ── Mobile responsive ─────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .about-intro {
      padding: var(--space-2xl) 0;
    }

    .intro-headline {
      font-size: clamp(1.75rem, 7vw, 2.25rem);
    }

    /* Mobile: portrait stacks above bio (single column) */
    .portrait-inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .portrait-col {
      max-width: 280px;
      margin: 0 auto;
    }

    .bio-heading {
      font-size: clamp(1.5rem, 6vw, 2rem);
    }

    .philosophy-heading {
      font-size: clamp(1.5rem, 6vw, 2rem);
    }
  }

  @media (max-width: 1023px) and (min-width: 768px) {
    /* Tablet: keep 2-col but tighten the grid ratio */
    .portrait-inner {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-xl);
    }
  }
</style>
