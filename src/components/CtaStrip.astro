---
/**
 * CtaStrip.astro — bottom-of-page contact CTA band (S3 §3.4)
 * Used at the bottom of Clinic and About pages.
 */
import Button from "./Button.astro";

export interface Props {
  sentence: string;
  buttonLabel: string;
  buttonHref: string;
}

const { sentence, buttonLabel, buttonHref } = Astro.props;
---

<section class="cta-strip">
  <div class="container cta-inner">
    <p class="cta-sentence">{sentence}</p>
    <Button variant="primary" href={buttonHref} label={buttonLabel} />
  </div>
</section>

<style>
  .cta-strip {
    background: var(--color-primary);
    padding: var(--space-2xl) 0;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .cta-sentence {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-white);
    line-height: 1.3;
    max-width: 36rem;
  }

  @media (max-width: 768px) {
    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-lg);
    }

    .cta-sentence {
      font-size: var(--text-body-xl);
    }
  }
</style>
