---
/**
 * Header.astro — sticky site header (§06 00-layout.md §3)
 * Matches the phase-02 design: wordmark + Korean subtitle + primary nav +
 * language toggle. No header phone pill, no header Contact-Us button
 * (both removed in the phase-02 rework). Contact stays reachable via nav
 * and the mobile drawer CTA.
 * Purely server-rendered; HamburgerMenu has a small client:visible JS island.
 */
import type { LocaleBundle } from "../lib/i18n.ts";
import { getString } from "../lib/i18n.ts";
import LanguageToggle from "./LanguageToggle.astro";
import HamburgerMenu from "./HamburgerMenu.astro";

export interface Props {
  locale: "en" | "ko";
  currentPath: string;
  bundle: LocaleBundle;
}

const { locale, currentPath, bundle } = Astro.props;
const logoLabel = getString(bundle, "common.header.logoAriaLabel");
const wordmarkSubtitle = getString(bundle, "common.header.wordmarkSubtitle");
const navLabel = getString(bundle, "common.nav.ariaLabel");
const navClinic = getString(bundle, "common.nav.clinic");
const navAbout = getString(bundle, "common.nav.about");
const navContact = getString(bundle, "common.nav.contact");
---

<header class="site-header">
  <div class="container inner">
    {/* Logo / wordmark + Korean subtitle */}
    <a class="site-logo" href={`/${locale}/`} aria-label={logoLabel}>
      <span class="logo-text">TCM Clinic The Present</span>
      <span class="logo-subtitle">{wordmarkSubtitle}</span>
    </a>

    {/* Desktop primary navigation */}
    <nav class="desktop-nav" aria-label={navLabel}>
      <ul>
        <li>
          <a
            href={`/${locale}/clinic/`}
            aria-current={currentPath === "/clinic" ? "page" : undefined}
          >{navClinic}</a>
        </li>
        <li>
          <a
            href={`/${locale}/about/`}
            aria-current={currentPath === "/about" ? "page" : undefined}
          >{navAbout}</a>
        </li>
        <li>
          <a
            href={`/${locale}/contact/`}
            aria-current={currentPath === "/contact" ? "page" : undefined}
          >{navContact}</a>
        </li>
      </ul>
    </nav>

    {/* Desktop right cluster — language toggle only */}
    <div class="header-actions">
      <LanguageToggle locale={locale} currentPath={currentPath} bundle={bundle} />
    </div>

    {/* Mobile: hamburger only */}
    <div class="mobile-actions">
      <HamburgerMenu locale={locale} currentPath={currentPath} bundle={bundle} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 2px 12px rgba(0, 30, 43, 0.07);
    height: 72px;
    display: flex;
    align-items: center;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-logo {
    flex-shrink: 0;
    text-decoration: none;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.2;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    white-space: nowrap;
  }

  .logo-subtitle {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-top: 2px;
    white-space: nowrap;
  }

  .desktop-nav {
    flex: 1;
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .desktop-nav a {
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--color-text-heading);
    text-decoration: none;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .mobile-actions {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .site-header {
      height: 60px;
    }

    .desktop-nav,
    .header-actions {
      display: none;
    }

    .mobile-actions {
      display: flex;
    }
  }
</style>
